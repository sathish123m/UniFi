# ============================================================
#  UniFi Backend — Environment Variables
#  Copy this to .env and fill in your values
#  NEVER commit .env to git
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050
APP_URL=http://localhost:5050
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Safety switch: never return OTP in API response unless explicitly true in development
EXPOSE_DEV_OTP=false
ALLOWED_UNIVERSITY_DOMAINS=lpu.in,rguktn.ac.in
# Backward-compatible key used by seed script (optional)
ALLOWED_UNIVERSITY_DOMAIN=lpu.in

# ── Database ─────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/unifi_db"
# On deploy, run seed after schema sync (Render-friendly when shell access is unavailable).
# Keep FALSE in production; only enable for a one-time first-run bootstrap.
DB_SEED_ON_DEPLOY=false
# Seed demo borrower/provider credentials (NON-PRODUCTION test mode only)
SEED_TEST_USERS=false

# ── First admin bootstrap (used by seed when creating the initial SUPER_ADMIN) ──
# Required for seeding an admin. No admin is created if these are unset.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_FIRST_NAME="Platform"
SEED_ADMIN_LAST_NAME="Admin"

# ── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────────────────────
# Generate a UNIQUE secret per environment. NEVER reuse these placeholders.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_generate_64_byte_hex_secret"
JWT_REFRESH_SECRET="CHANGE_ME_generate_a_DIFFERENT_64_byte_hex_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Encryption (AES-256 for UPI IDs) ─────────────────────────
# Generate a UNIQUE 32-byte (64 hex char) key. NEVER reuse this placeholder.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="CHANGE_ME_generate_32_byte_64_hex_char_key"

# ── Payments ─────────────────────────────────────────────────
# UniFi is non-custodial and runs in record-only mode: there is no payment
# gateway and no money custody. Peers settle directly (UPI/cash) and each side
# confirms the handover and the repayment in-app. No gateway keys are required.
#
# (The custodial Razorpay flow was removed — see docs/PATH2_RECORD_ONLY_PLAN.md
# and docs/LANDSCAPE_AND_COMPLIANCE.md.)

# ── Email (Nodemailer) ────────────────────────────────────────
# For production, use your SMTP provider (Brevo/SendGrid/Mailgun/SES etc.)
# Typical values:
#   Port 587 => SMTP_SECURE=false
#   Port 465 => SMTP_SECURE=true
# Email delivery mode:
#   EMAIL_PROVIDER=SMTP (default)
#   EMAIL_PROVIDER=BREVO_API (uses HTTPS Brevo API, avoids SMTP socket issues)
#   EMAIL_PROVIDER=MAILJET_API (uses HTTPS Mailjet API, avoids SMTP socket issues)
EMAIL_PROVIDER=SMTP
# Per-provider send attempts with linear backoff (1-5).
EMAIL_SEND_RETRIES=3
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_ALLOW_SELF_SIGNED=false
SMTP_STRICT=true
SMTP_VERIFY_ON_STARTUP=false
SMTP_CONNECTION_TIMEOUT_MS=12000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_FROM_NAME="UniFi"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password_or_key"
SMTP_FROM="noreply@yourdomain.com"
SMTP_TEST_TO="you@yourdomain.com"
# Optional fallback over HTTPS when SMTP times out on cloud providers
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="UniFi"
MAILJET_API_KEY=""
MAILJET_API_SECRET=""
MAILJET_SENDER_EMAIL=""
MAILJET_SENDER_NAME="UniFi"

# ── SMS OTP Fallback ─────────────────────────────────────────
# SMS_PROVIDER=MOCK (logs OTP server-side), SMS_PROVIDER=TWILIO (real SMS)
SMS_PROVIDER=MOCK
SMS_STRICT=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""  # E.164 format, e.g. +14155552671 (TWILIO_FROM also accepted)

# ── File Storage (Cloudflare R2 — free 10GB) ─────────────────
# REQUIRED in production: without R2 the backend refuses to store KYC documents
# (Render's disk is ephemeral and would lose user identity scans on restart).
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="XXXXXXXXXXXXXXXXXXXXXXXX"
R2_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
R2_BUCKET_NAME="unifi-kyc-docs"
R2_PUBLIC_URL="https://your-r2-domain.com"  # Only for non-sensitive assets

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000    # 1 minute
RATE_LIMIT_MAX_REQUESTS=100   # per IP per window
AUTH_RATE_LIMIT_MAX=20        # per IP per 15 min; raise if campus NAT is shared
OTP_RATE_LIMIT_MAX=3          # per IP per minute for resend/verify OTP

# ── Collections / Risk Controls ──────────────────────────────
DEFAULT_AFTER_DAYS=15         # Auto mark ACTIVE loan as DEFAULTED after due date + N days
# No late fee: UniFi is interest-free and never charges penalties. Overdue and
# defaulted loans affect reputation/credit score only.

# ── Admin ─────────────────────────────────────────────────────
ADMIN_URL_PREFIX="/admin-x7k2"   # Obscure the admin URL
