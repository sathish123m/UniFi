// ============================================================
//  UniFi — Prisma Database Schema
//  Database: PostgreSQL
//  ORM: Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  MOD_ADMIN
  FINANCE_ADMIN
  BORROWER
  PROVIDER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  PENDING          // Waiting for a peer to commit to lending
  FUNDED           // Peer committed; awaiting handover confirmation from both sides
  ACTIVE           // Both sides confirmed the handover; money is with the borrower
  REPAID           // Both sides confirmed the repayment
  DEFAULTED        // Past due date without repayment
  CANCELLED        // No peer within 24h / borrower cancelled
}

// UniFi is non-custodial: no money flows through the platform. These rows are a
// confirmation ledger recording what the two peers attested to, not a transfer.
enum TransactionType {
  DISBURSEMENT     // Lender attests the money was handed to the borrower
  REPAYMENT        // Borrower attests the money was repaid to the lender
  PROVIDER_PAYOUT  // Legacy (custodial era) — retained for old rows only
  PLATFORM_FEE     // Legacy (custodial era) — retained for old rows only
  REFUND           // Legacy (custodial era) — retained for old rows only
}

enum TransactionStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum LoanPurpose {
  FOOD
  BOOKS
  TRANSPORT
  MEDICAL
  ACCOMMODATION
  EMERGENCY
  OTHER
}

enum Tenure {
  SEVEN     // 7 days
  FOURTEEN  // 14 days
  THIRTY    // 30 days
}

enum NotificationType {
  LOAN_FUNDED
  LOAN_DISBURSED
  REPAYMENT_DUE
  REPAYMENT_SUCCESS
  REPAYMENT_OVERDUE
  KYC_APPROVED
  KYC_REJECTED
  ACCOUNT_SUSPENDED
  CREDIT_SCORE_UPDATED
  GENERAL
}

enum AuditAction {
  USER_CREATED
  USER_SUSPENDED
  USER_BANNED
  USER_RESTORED
  KYC_REVIEWED
  LOAN_CREATED
  LOAN_FUNDED
  LOAN_CANCELLED
  LOAN_DEFAULTED_FLAGGED
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  PLATFORM_CONFIG_CHANGED
  ADMIN_LOGIN
  ADMIN_CREATED
  ADMIN_REVOKED
}

// ============================================================
//  UNIVERSITY
//  Seed with known universities; used to validate email domains
// ============================================================

model University {
  id           String   @id @default(cuid())
  name         String
  shortName    String   // e.g. "VIT", "BITS"
  emailDomain  String   @unique  // e.g. "vitstudent.ac.in"
  city         String
  state        String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  users        User[]

  @@index([emailDomain])
  @@map("universities")
}

// ============================================================
//  USER
//  Single table for all roles. Role field determines access.
// ============================================================

model User {
  id               String     @id @default(cuid())
  email            String
  passwordHash     String
  role             Role       @default(BORROWER)
  firstName        String
  lastName         String
  phone            String?

  // University linkage
  universityId     String?
  university       University? @relation(fields: [universityId], references: [id])
  studentIdNumber  String?    // Their enrollment/roll number

  // KYC
  kycStatus        KycStatus  @default(PENDING)
  kycReviewedAt    DateTime?
  kycReviewedById  String?    // Admin user ID who reviewed
  kycRejectReason  String?

  // UPI
  upiId            String?    // AES-256 encrypted at app layer before storing
  upiVerified      Boolean    @default(false)

  // Legacy payout destination (custodial era). UniFi no longer pays providers —
  // peers settle directly — so this is unused; retained for old rows only.
  payoutFundAccountId String?

  // Credit Score (300–900, starts at 500)
  creditScore      Int        @default(500)
  borrowLimit      Int        @default(5000)   // in ₹, upgrades with score

  // Account state
  isActive         Boolean    @default(true)
  isSuspended      Boolean    @default(false)
  isBanned         Boolean    @default(false)
  suspendReason    String?
  emailVerified    Boolean    @default(false)

  // Timestamps
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  lastLoginAt      DateTime?

  // Relations
  kycDocument      KycDocument?
  borrowerLoans    Loan[]     @relation("BorrowerLoans")
  providerLoans    Loan[]     @relation("ProviderLoans")
  transactions     Transaction[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  otpCodes         OtpCode[]
  creditHistory    CreditScoreHistory[]
  deviceSessions   DeviceSession[]
  auditActionsBy   AuditLog[] @relation("AdminAuditLogs")

  @@index([email])
  @@unique([email, role])
  @@index([phone])
  @@index([role])
  @@index([kycStatus])
  @@index([universityId])
  @@map("users")
}

// ============================================================
//  KYC DOCUMENT
//  Student ID image + selfie stored as S3/R2 keys (never public URLs)
// ============================================================

model KycDocument {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentIdFrontKey  String?   // S3/R2 object key (nullable: uploaded piecemeal)
  studentIdBackKey   String?   // optional back side
  selfieKey          String?   // live selfie (nullable: uploaded piecemeal)

  // Government identity (India KYC). Numbers are AES-256-GCM encrypted at rest
  // (iv:tag:ciphertext) — never stored or logged in plaintext. The document
  // images are private object keys, streamed only to authenticated admins.
  aadhaarNumberEnc   String?   // encrypted 12-digit Aadhaar (Verhoeff-validated on entry)
  aadhaarFrontKey    String?   // Aadhaar card front image
  aadhaarBackKey     String?   // Aadhaar card back image
  panNumberEnc       String?   // encrypted PAN (e.g. ABCPZ1234K, pattern-validated on entry)
  panDocKey          String?   // PAN card image

  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  adminNotes         String?   // Internal admin notes

  @@map("kyc_documents")
}

// ============================================================
//  OTP CODES
//  Email verification + login OTP
// ============================================================

model OtpCode {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String   // 6-digit hashed
  purpose    String   // "EMAIL_VERIFY" | "LOGIN" | "UPI_VERIFY"
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, purpose])
  @@map("otp_codes")
}

// ============================================================
//  REFRESH TOKENS
//  JWT rotation — one active refresh token per device
// ============================================================

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique  // SHA-256 hash of the actual token
  deviceId    String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================
//  DEVICE SESSIONS
//  Fingerprint-based fraud check: same device = same person
// ============================================================

model DeviceSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String   // Browser/device fingerprint hash
  ipAddress   String
  userAgent   String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, fingerprint])
  @@index([fingerprint])
  @@map("device_sessions")
}

// ============================================================
//  PLATFORM CONFIG
//  Admin-editable settings: borrowing limits and score tiers.
//  (Interest/fee fields are legacy from the custodial era and unused.)
// ============================================================

model PlatformConfig {
  id                    String   @id @default(cuid())

  // Legacy (custodial era) — always ignored; kept for historical rows.
  interestRatePercent   Decimal  @default(0)
  platformFeePercent    Decimal  @default(0)

  // Loan limits (in ₹)
  minLoanAmount         Int      @default(500)
  maxLoanAmount         Int      @default(10000)

  // Credit score borrow limits
  scoreTier1MinScore    Int      @default(300)
  scoreTier1Limit       Int      @default(2000)   // ₹
  scoreTier2MinScore    Int      @default(600)
  scoreTier2Limit       Int      @default(5000)
  scoreTier3MinScore    Int      @default(750)
  scoreTier3Limit       Int      @default(10000)

  // Time limits
  providerAcceptWindowHours  Int @default(24)  // Loan cancelled if unfunded in 24h
  providerFundWindowHours    Int @default(2)   // Provider must pay within 2h of accepting

  // Effective from (allows scheduling config changes)
  effectiveFrom         DateTime @default(now())
  createdByAdminId      String
  createdAt             DateTime @default(now())

  @@map("platform_config")
}

// ============================================================
//  LOAN
//  Core entity. Links borrower ↔ provider.
// ============================================================

model Loan {
  id               String      @id @default(cuid())

  // Parties
  borrowerId       String
  borrower         User        @relation("BorrowerLoans", fields: [borrowerId], references: [id])
  providerId       String?     // Null until a provider funds it
  provider         User?       @relation("ProviderLoans", fields: [providerId], references: [id])

  // Loan terms
  //
  // UniFi is non-custodial and interest-free: peers settle directly. These
  // amount/rate columns are retained so historical (custodial-era) rows keep
  // their values; new rows always store zero interest and
  // `totalRepayAmount == principalAmount`.
  principalAmount  Int         // in ₹ (paise avoided for simplicity)
  interestAmount   Int         // always 0 for new loans
  platformFeeAmount Int        // always 0 for new loans
  totalRepayAmount Int         // equals principalAmount for new loans
  providerEarning  Int         // always 0 for new loans

  interestRate     Decimal     @default(0) // always 0 for new loans
  platformFeeRate  Decimal     @default(0) // always 0 for new loans
  tenure           Tenure

  // Purpose & display
  purpose          LoanPurpose @default(OTHER)
  purposeNote      String?     // Optional one-liner from borrower

  // Anonymised ID shown in marketplace (e.g. "UniFi#2847")
  publicId         String      @unique

  // Status lifecycle
  status           LoanStatus  @default(PENDING)

  // Key timestamps
  requestedAt        DateTime    @default(now())
  fundedAt           DateTime?   // Peer committed to lending
  fundingSentAt      DateTime?   // Lender attests the money was handed over
  fundingReceivedAt  DateTime?   // Borrower confirms the money was received
  disbursedAt        DateTime?   // Set when BOTH sides confirm the handover
  dueAt              DateTime?   // Computed: disbursedAt + tenure days
  repayClaimedAt     DateTime?   // Borrower attests the money was repaid
  repayConfirmedAt   DateTime?   // Lender confirms the repayment was received
  repaidAt           DateTime?   // Set when BOTH sides confirm the repayment
  cancelledAt        DateTime?
  defaultedAt        DateTime?

  // Disputes — either party can flag a problem; surfaced to campus admins.
  disputedAt         DateTime?
  disputeReason      String?
  disputeBy          String?     // userId who raised it

  // Legacy Razorpay references (custodial era; unused now)
  rzpOrderId       String?
  rzpPaymentId     String?
  rzpRepayOrderId  String?
  rzpRepayPaymentId String?

  // Overdue tracking (reputation only — no late fee is ever charged)
  isOverdue        Boolean     @default(false)
  overdueDays      Int         @default(0)
  lateFeeAmount    Int         @default(0) // always 0

  // Soft delete / archive
  isArchived       Boolean     @default(false)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  transactions     Transaction[]

  @@index([borrowerId])
  @@index([providerId])
  @@index([status])
  @@index([publicId])
  @@index([dueAt])
  @@index([requestedAt])
  @@index([disputedAt])
  @@map("loans")
}

// ============================================================
//  TRANSACTION
//  Confirmation ledger. Records what each peer attested to (handover, repayment).
//  Never update — only insert. In the custodial era this tracked money movements;
//  UniFi is non-custodial now, so no row here implies the platform held funds.
// ============================================================

model Transaction {
  id               String            @id @default(cuid())
  loanId           String
  loan             Loan              @relation(fields: [loanId], references: [id])
  userId           String            // Who initiated / who is affected
  user             User              @relation(fields: [userId], references: [id])

  type             TransactionType
  status           TransactionStatus @default(INITIATED)
  amount           Int               // in ₹

  // Legacy Razorpay references (custodial era; unused now)
  rzpOrderId       String?
  rzpPaymentId     String?
  rzpSignature     String?
  rzpRefId         String?

  // Legacy payout settlement (custodial era; unused now). `settledAt` and
  // `settlementRef` are retained so historical rows keep their reconciliation
  // data; no new row uses them.
  settledAt        DateTime?
  settlementRef    String?

  // Idempotency
  idempotencyKey   String            @unique  // Prevents duplicate charges

  // Metadata
  description      String?
  failureReason    String?
  reversedAt       DateTime?

  initiatedAt      DateTime          @default(now())
  completedAt      DateTime?

  @@index([loanId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([rzpPaymentId])
  @@index([rzpOrderId])
  @@index([idempotencyKey])
  @@index([type, settledAt])
  @@map("transactions")
}

// ============================================================
//  CREDIT SCORE HISTORY
//  Every change to a user's score is recorded
// ============================================================

model CreditScoreHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  previousScore Int
  newScore      Int
  delta         Int    // positive = improved, negative = dropped
  reason        String // e.g. "On-time repayment", "Defaulted loan", "Account age"
  loanId        String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("credit_score_history")
}

// ============================================================
//  NOTIFICATION
//  In-app + push notification log
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  data      Json?            // Extra payload (loanId, amount, etc.)

  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
//  AUDIT LOG
//  Immutable. Every admin action recorded. Non-deletable.
// ============================================================

model AuditLog {
  id          String      @id @default(cuid())
  adminId     String
  admin       User        @relation("AdminAuditLogs", fields: [adminId], references: [id])

  action      AuditAction
  targetType  String      // "User" | "Loan" | "Transaction" | "Config"
  targetId    String      // ID of the affected record
  description String
  metadata    Json?       // Before/after values for config changes

  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
//  RATE LIMIT LOG
//  Redis handles runtime limiting; this is the persistent record
//  for security audits of suspicious IPs
// ============================================================

model RateLimitLog {
  id         String   @id @default(cuid())
  identifier String   // IP or userId
  endpoint   String
  hitCount   Int      @default(1)
  windowStart DateTime
  blocked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([windowStart])
  @@map("rate_limit_logs")
}
